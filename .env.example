# Extra GitHub repos to ingest (comma-separated org/repo slugs).
# These are appended to the default repos:
#   pipecat-ai/pipecat, pipecat-ai/pipecat-examples, daily-co/daily-python,
#   pipecat-ai/pipecat-client-web,
#   pipecat-ai/pipecat-client-web-transports,
#   pipecat-ai/pipecat-client-react-native-transports,
#   pipecat-ai/pipecat-ui, pipecat-ai/pipecat-prebuilt
# PIPECAT_HUB_EXTRA_REPOS="your-org/repo-1,your-org/repo-2"
#
# NOTE: only Python (.py/.pyi), TypeScript (.ts/.tsx), and RST (docs/**.rst)
# are parsed. Swift/Kotlin/C++ client SDKs (pipecat-client-ios,
# pipecat-client-android, pipecat-client-cxx, pipecat-esp32) clone but yield
# ZERO source/API chunks (only a few README/config fallback chunks) until a
# grammar for those languages exists — they won't surface in search_api.
# Entries below that duplicate a default are deduped automatically — harmless
# to leave in.
#
# Only public, non-archived repos are listed (last checked 2026-10-16): a private
# repo cannot be cloned without access. Private pipecat-ai repos such as
# pipecat-krisp or hosted-smart-turn are left out on purpose.

# --------------------------------------------------------------------------
# Recommended extras — copy/uncomment what you need
# --------------------------------------------------------------------------

# Client SDKs & transports (web, mobile, native)
# (pipecat-client-cxx-daily is archived — the Daily transport now lives in
# pipecat-client-cxx under transports/daily, which is already listed here)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/pipecat-client-web,pipecat-ai/pipecat-client-web-transports,pipecat-ai/pipecat-client-react-native-transports,pipecat-ai/pipecat-client-ios,pipecat-ai/pipecat-client-ios-daily,pipecat-ai/pipecat-client-ios-small-webrtc,pipecat-ai/pipecat-client-android,pipecat-ai/pipecat-client-android-transports,pipecat-ai/pipecat-client-cxx,pipecat-ai/pipecat-esp32"

# Legacy Voice UI Kit (npm package, superseded by pipecat-ai/pipecat-ui which is a default)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/voice-ui-kit"

# Conversation flows & structured dialogues
# (pipecat-ai/pipecat-flows is archived — flows ships inside pipecat-ai/pipecat
# as `pipecat.flows` since 1.5.0 and is already indexed from there; adding the
# archived repo back reintroduces duplicate hits under the legacy module path)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/pipecat-flows-editor"

# Cloud, CLI, and dev tools
# (pipecat-ai/pipecat-cli is archived — the CLI is now part of pipecat-ai/pipecat,
# which is already indexed; adding the archived repo back only adds stale hits)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/tail,pipecat-ai/whisker,pipecat-ai/skills"

# Quickstart templates
# (pipecat-quickstart* repos are archived — use the CLI: `uv tool install pipecat-ai-cli` then `pipecat init quickstart`)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/pipecat-prebuilt"

# Audio, turn detection & benchmarks
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/smart-turn,pipecat-ai/stt-benchmark,pipecat-ai/gb-benchmarks"

# Example apps & demos
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/peekaboo,pipecat-ai/pipecat-mcp-server,pipecat-ai/pipecat-music-player,pipecat-ai/yc-voice-agents-hackathon,pipecat-ai/pipecat-deepgram-webinar-demo"

# Gradient Bang ecosystem
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/gradient-bang,pipecat-ai/gb-context-viewer"

# iOS demo apps (Swift; clone but yield no source chunks — see the note at the top)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/pipecat-client-ios-gemini-live-websocket-demo,pipecat-ai/pipecat-client-ios-openai-realtime-webrtc-demo"

# Vendor: NVIDIA (Nemotron speech and voice models)
# (pipecat-ai/nvidia-sgmaker is private, so it cannot be cloned without access and is not listed)
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/nemotron-january-2026,pipecat-ai/nemotron-voicechat-dgx-spark,pipecat-ai/nemo3-battleships"

# Vendor: Google (Gemini Live)
# No Google-owned Pipecat repos found (searched 2026-10-16). The Gemini Live iOS
# demo is under "iOS demo apps" above; the Android demo is Kotlin and yields no chunks.
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/gemini-live-web-starter"

# Vendor: AWS (Bedrock, SageMaker)
# PIPECAT_HUB_EXTRA_REPOS="aws-samples/build-intelligent-ai-voice-agents-with-pipecat-and-amazon-bedrock,pipecat-ai/aws-workshops,pipecat-ai/aws-deepgram-workshop,deepgram/rxconnect-deepgram-pipecat-sagemaker-demo,chadbailey59/aws-telephony-bot"

# Vendor: Meta — no Meta-owned Pipecat repos found (searched 2026-10-16), so no
# section; re-check before adding one.

# Community and maintainer projects (individual repos, not the pipecat-ai org)
# These are personal projects: they may be rewritten or archived without notice.
# PIPECAT_HUB_EXTRA_REPOS="jptaylor/pipecat-visemes,jptaylor/pipecat-one-pipeline-two-characters,chadbailey59/caracal,chadbailey59/agent-voice-bot"

# --------------------------------------------------------------------------
# All recommended repos in one line (copy and uncomment):
# PIPECAT_HUB_EXTRA_REPOS="pipecat-ai/pipecat-client-web,pipecat-ai/pipecat-client-web-transports,pipecat-ai/pipecat-client-react-native-transports,pipecat-ai/pipecat-client-ios,pipecat-ai/pipecat-client-ios-daily,pipecat-ai/pipecat-client-ios-small-webrtc,pipecat-ai/pipecat-client-android,pipecat-ai/pipecat-client-android-transports,pipecat-ai/pipecat-client-cxx,pipecat-ai/pipecat-esp32,pipecat-ai/voice-ui-kit,pipecat-ai/pipecat-flows-editor,pipecat-ai/tail,pipecat-ai/whisker,pipecat-ai/skills,pipecat-ai/pipecat-prebuilt,pipecat-ai/smart-turn,pipecat-ai/stt-benchmark,pipecat-ai/gb-benchmarks,pipecat-ai/peekaboo,pipecat-ai/pipecat-mcp-server,pipecat-ai/pipecat-music-player,pipecat-ai/yc-voice-agents-hackathon,pipecat-ai/pipecat-deepgram-webinar-demo,pipecat-ai/gradient-bang,pipecat-ai/gb-context-viewer,pipecat-ai/pipecat-client-ios-gemini-live-websocket-demo,pipecat-ai/pipecat-client-ios-openai-realtime-webrtc-demo,pipecat-ai/nemotron-january-2026,pipecat-ai/nemotron-voicechat-dgx-spark,pipecat-ai/nemo3-battleships,pipecat-ai/gemini-live-web-starter,aws-samples/build-intelligent-ai-voice-agents-with-pipecat-and-amazon-bedrock,pipecat-ai/aws-workshops,pipecat-ai/aws-deepgram-workshop,deepgram/rxconnect-deepgram-pipecat-sagemaker-demo,chadbailey59/aws-telephony-bot,jptaylor/pipecat-visemes,jptaylor/pipecat-one-pipeline-two-characters,chadbailey59/caracal,chadbailey59/agent-voice-bot"
# --------------------------------------------------------------------------

# Entire repos to skip locally if an upstream source is tainted.
# PIPECAT_HUB_TAINTED_REPOS="your-org/bad-repo,other-org/paused-repo"

# Specific upstream refs to skip locally.
# Format: org/repo@ref where ref is a tag or commit SHA/prefix.
# PIPECAT_HUB_TAINTED_REFS="pipecat-ai/pipecat@v0.0.9,pipecat-ai/pipecat-examples@deadbeef"

# --------------------------------------------------------------------------
# Startup model pre-warm (default: on)
# --------------------------------------------------------------------------
# On `serve` boot, the hub loads the embedding model (and cross-encoder if
# enabled) so the first MCP query doesn't pay a cold-start cost. On Windows
# CPU this can otherwise hang the first query for 30-130s — longer than
# Claude Code's tool-permission window, which surfaces as a spurious
# disconnect.
#
# Set to 0 to skip pre-warm (faster boot, slower first query):
# PIPECAT_HUB_WARMUP=0

# --------------------------------------------------------------------------
# Index-staleness footer (default: 7 days)
# --------------------------------------------------------------------------
# When the local index is older than this many days, every tool response (MCP
# and the CLI subcommands) carries an `index_staleness` field nudging you to
# run `refresh`. The field is absent while the index is fresh.
#
# Set to 0 (or any value <= 0) to disable the footer entirely. Non-numeric or
# non-finite values (e.g. inf, nan) are rejected with a warning and fall back
# to the 7-day default.
# PIPECAT_HUB_STALE_AFTER_DAYS=7
